rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tracking page looks shipments up by ID, so reads are public; only signed-in admins write
    match /shipments/{id} { allow read: if true; allow write: if request.auth != null; }
    // Anyone can submit the contact form; only admins can read or manage messages
    match /contacts/{id} { allow create: if true; allow read, update, delete: if request.auth != null; }
    match /{document=**} { allow read, write: if false; }
  }
}
